.DS_Store
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.streamlit/secrets.toml
.claude/
.env
.env.*
!.env.example
*.numbers

# Local drafts not intended for public release.
docs/*_*_BRIEF.md
docs/*_*_GUIDE.md

# Source job text may be licence-restricted.
data/raw/*
!data/raw/.gitkeep
data/private/
data/external/*
!data/external/.gitkeep

# Reproducible pipeline outputs.
data/processed/*
!data/processed/.gitkeep
data/synthetic/job_ads.csv

# Retrieval artefacts. Chunks and embeddings are derived from licensed
# advertisement text, so they live under data/private/ and never reach git.
# data/synthetic/retrieval_corpus.csv is deliberately NOT ignored: it is the
# fictional corpus that makes the pipeline reproducible.
data/private/retrieval/

*.duckdb
*.joblib

# Local planning documents, not part of the published project.
RAG_PROJECT_BRIEF.md
DOCKER_BRIEF.md

# Local portfolio-only output.
reports/figures/

# Optional: keep Chinese personal workflow out of the public repo.
docs/JOB_SEARCH_WORKFLOW.zh-CN.md

# Chinese/local planning docs.
*.zh-CN.md
RAG_PROJECT_BRIEF.md
DOCKER_BRIEF.md
docs/*_BRIEF.md
docs/*_GUIDE.md